# --- Local Development Variables ---
PORT=3000
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=itelect2_dev
DB_HOST=localhost

# Must be at least 32 characters
JWT_SECRET=paste_your_own_64_character_hex_string_here

# Allowed browser origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# --- Render Production Variables (Set on Render Dashboard) ---
# DATABASE_URL= (Internal Database URL from Render Postgres)
# JWT_SECRET=   (A new secure secret generated for production)
